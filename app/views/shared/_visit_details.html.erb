<dl class="details">
  <div><dt>Date</dt><dd><%= visit_date(visit) %></dd></div>
  <div><dt>Evaluator</dt><dd><%= visit.evaluator %></dd></div>
  <div><dt>Arrived</dt><dd><%= visit.arrived || "–" %></dd></div>
  <div><dt>Departed</dt><dd><%= visit.departed || "–" %></dd></div>
  <div><dt>Party</dt><dd><%= visit.party_size || "–" %></dd></div>
  <div><dt>Table</dt><dd><%= visit.table || "–" %></dd></div>
  <div><dt>Check #</dt><dd><%= visit.check_number || "–" %></dd></div>
  <div><dt>Check total</dt><dd><%= money(visit.check_amount) %></dd></div>
  <div><dt>All items billed</dt><dd><%= yes_no(visit.all_items_billed) %></dd></div>
</dl>
